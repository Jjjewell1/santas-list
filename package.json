    "db:seed": "node prisma/seed.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cheerio": "^1.0.0",
    "jose": "^5.9.6",
    "next": "15.5.23",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pngjs": "^7.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
