# Copy to .env and fill in real values. NEVER commit your real .env.
DATABASE_URL="file:./data/christmas.db"
# Long random string (>=32 chars). Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
# Public URL of the app — used to build absolute share links. Set to the
# real URL in production (e.g. https://christmas.jewellcore.com).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Timezone used for the countdown and 12 Days board
TZ="America/Chicago"
